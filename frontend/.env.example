# ── Network ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=testnet

# ── Tatum API Keys (get from tatum.io) ───────────────────────────────────────
NEXT_PUBLIC_TATUM_TESTNET_KEY=t-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_TATUM_MAINNET_KEY=t-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sui Contract IDs (filled by scripts/deploy.ts) ───────────────────────────
NEXT_PUBLIC_TESTNET_PACKAGE_ID=
NEXT_PUBLIC_TESTNET_TREASURY_ID=
NEXT_PUBLIC_TESTNET_ADMIN_CAP_ID=
NEXT_PUBLIC_TESTNET_TOKEN_CAP_ID=

NEXT_PUBLIC_MAINNET_PACKAGE_ID=
NEXT_PUBLIC_MAINNET_TREASURY_ID=
NEXT_PUBLIC_MAINNET_ADMIN_CAP_ID=
NEXT_PUBLIC_MAINNET_TOKEN_CAP_ID=

# ── Walrus Memory (MemWal) ────────────────────────────────────────────────────
MEMWAL_ACCOUNT_ID=0x...
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_AGENT_ID=...
MEMWAL_PRIVATE_KEY=...
